[Unit]
Description=EAP Enterprise Agent Platform Backend
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=wangyan
Group=wangyan
WorkingDirectory=/home/wangyan/deploy/eap/backend
Environment=FLASK_ENV=production
Environment=DATABASE_URL=postgresql://eap:CHANGE_ME@127.0.0.1:5432/eap
Environment=REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
Environment=LLM_PROVIDER=deepseek
Environment=LLM_MODEL=deepseek-v4-pro
Environment=CORS_ALLOWED_ORIGINS=http://192.168.1.51,http://192.168.1.51:3000,http://localhost:3000
EnvironmentFile=-/home/wangyan/deploy/eap/backend/.env
ExecStart=/home/wangyan/deploy/eap/backend/.venv/bin/gunicorn wsgi:app \
    --bind 0.0.0.0:5003 \
    --worker-class gevent \
    --workers 4 \
    --timeout 120 \
    --access-logfile /home/wangyan/deploy/eap/logs/access.log \
    --error-logfile /home/wangyan/deploy/eap/logs/error.log
Restart=always
RestartSec=5
StandardOutput=append:/home/wangyan/deploy/eap/logs/stdout.log
StandardError=append:/home/wangyan/deploy/eap/logs/stderr.log

[Install]
WantedBy=multi-user.target
